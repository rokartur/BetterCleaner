<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rokartur.BetterCleaner.Helper</string>
    <!-- Executable path inside the app bundle (SMAppService resolves it). -->
    <key>BundleProgram</key>
    <string>Contents/MacOS/BetterCleanerHelper</string>
    <!-- The mach service the app connects to. -->
    <key>MachServices</key>
    <dict>
        <key>com.rokartur.BetterCleaner.Helper</key>
        <true/>
    </dict>
    <!-- Ties the daemon's approval to the app in System Settings > Login Items. -->
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.rokartur.BetterCleaner</string>
    </array>
</dict>
</plist>
